# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.turbo/
*.tsbuildinfo

# Generated fixture media — reproducible via scripts/generate-fixtures.ts.
# Never commit binary media to this repository.
fixtures/

# Real media dropped in for end-to-end tests. Personal, and binary — this stays
# on your machine and never reaches the remote.
incoming/

# Render output
out/
*.mp4
*.mov
*.wav
*.mp3
*.m4a

# Remotion
.remotion/

# Test artifacts
coverage/
test-results/
playwright-report/
# Golden-frame diffs are artifacts; the committed goldens under
# packages/render/test/golden/ are force-added and stay tracked.
**/__diff_output__/

# Environment
.env
.env.*
!.env.example

# Editor / OS
.DS_Store
.idea/
*.swp

# Derived project directories built from incoming/ media.
project/

# Local env
.env
.env.local

# Next.js
.next/
next-env.d.ts

# Local object store — customer media, never committed.
.storage/
