# Three connections, not one. @film/db refuses at startup if a worker or a
# migration is handed a transaction-pooled URL — pg-boss needs session state
# and LISTEN/NOTIFY, and through a pooler jobs are silently never delivered.

# Transaction-pooled (port 6543). Next.js request handlers only.
DATABASE_URL_WEB=postgres://postgres:film@localhost:55432/film

# Direct or session mode (port 5432). pg-boss and all workers.
DATABASE_URL_WORKER=postgres://postgres:film@localhost:55432/film

# Direct only. Drizzle Kit migrations, which need session-level locks.
DATABASE_URL_MIGRATIONS=postgres://postgres:film@localhost:55432/film

# Where the local object store keeps its files when R2 is not configured. The
# worker writes here and the web app reads here; they must agree.
STORAGE_ROOT=.storage

# Scratch space for stages. Defaults to the system temp directory.
# WORKER_TMP=/var/tmp/film

# Lets the validator accept the unlicensed temp bed. Never set in production.
ALLOW_UNLICENSED_MUSIC=1

# Private bucket. Signed URLs only, short TTLs, CORS scoped to known origins.
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
