{
  "name": "life-advice",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "//build:packages": "Everything a script needs, and NOT the web app. `pnpm build` runs `next build`, which writes apps/web/.next — the directory a running `pnpm web` is serving out of. It has taken the dev server down three times, always from a command whose name said nothing about Next: worker, bed:upload, intake. None of them needs the web app built.",
    "build:packages": "pnpm -r --filter=!@film/web run build",
    "//typecheck": "apps/web is NOT a project reference — Next owns its own tsconfig — so `tsc -b` never looked at it, and every web change since the app was built has been typechecked only by `next dev` as it happened to compile a route. Checked explicitly here.",
    "typecheck": "tsc -b --pretty && tsc -p tsconfig.test.json --pretty && pnpm --filter @film/web exec tsc --noEmit --pretty",
    "test": "vitest run",
    "test:watch": "vitest",
    "studio": "remotion studio packages/render/src/entry.ts",
    "film": "pnpm build && tsx scripts/render-fixture-film.ts",
    "fixtures": "tsx scripts/generate-fixtures.ts",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo out",
    "project:build": "pnpm build && tsx scripts/build-real-project.ts",
    "film:real": "pnpm project:build && tsx scripts/render-project.ts project/real",
    "db:up": "docker compose -f docker-compose.dev.yml up -d --wait",
    "auth:up": "supabase start",
    "auth:down": "supabase stop",
    "auth:status": "supabase status",
    "db:down": "docker compose -f docker-compose.dev.yml down -v",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/migrate.ts",
    "db:generate": "pnpm --filter @film/db exec drizzle-kit generate",
    "web": "pnpm --filter @film/web dev",
    "intake": "pnpm build:packages && tsx --env-file-if-exists=.env scripts/intake.ts",
    "bed:upload": "pnpm build:packages && tsx --env-file-if-exists=.env scripts/upload-bed.ts",
    "worker": "pnpm build:packages && tsx --env-file-if-exists=.env apps/worker/src/main.ts",
    "thumbs:backfill": "pnpm build:packages && tsx --env-file-if-exists=.env scripts/backfill-thumbnails.ts"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@film/db": "workspace:*",
    "@film/edl": "workspace:*",
    "@film/formats": "workspace:*",
    "@film/music": "workspace:*",
    "@film/pipeline": "workspace:*",
    "@film/queue": "workspace:*",
    "@film/render": "workspace:*",
    "@film/storage": "workspace:*",
    "@film/templates": "workspace:*",
    "@remotion/bundler": "^4.0.505",
    "@remotion/cli": "4.0.505",
    "@remotion/renderer": "^4.0.505",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.21.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "0.45.2",
    "pg": "^8.22.0",
    "pg-boss": "^12.27.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "server-only": "^0.0.1",
    "tslib": "^2.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
